VITE_APP_BACKEND_V2_GET_URL=https://json.excalidraw.com/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://json.excalidraw.com/api/v2/post/

# EventBooking: external library catalogue/publishing disabled (own library is bundled)
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com

# EventBooking: AI disabled
VITE_APP_AI_BACKEND=

# socket server URL used for collaboration — свой self-hosted excalidraw-room
# (excalidraw-room-proxy, за nginx TLS proxy на ws-excalidraw.new.local),
# не публичный сервер excalidraw.com.
VITE_APP_WS_SERVER_URL=https://ws-excalidraw.new.local

# Адрес бэкенда newdesign (не самой рисовалки) — DrawingController, роуты
# /drawing/*. Раньше был захардкожен в App.tsx/backendSync.ts/firebase.ts,
# теперь читается через этот параметр (см. data/eventbookingConfig.ts).
# На сервере переопределяется через .env.production.local.
VITE_APP_EVENTBOOKING_BACKEND_URL=https://eventbooking.new.local

# Больше не читается кодом вообще: вызовы Firebase вырезаны из
# excalidraw-app/data/firebase.ts (no-op вместо реальных firestore/storage
# запросов) — наш excalidraw-room не нуждается во внешнем хранилище, своя
# персистентность уже есть (chat_drawing_scene/chat_drawing_snapshot).
# Оставлено пустым, а не удалено, чтобы явно показать: значение сюда класть
# не нужно и незачем — не забыть при будущих апдейтах из апстрима, где
# firebase.ts всё ещё делает настоящие вызовы.
VITE_APP_FIREBASE_CONFIG=

VITE_APP_ENABLE_TRACKING=false

